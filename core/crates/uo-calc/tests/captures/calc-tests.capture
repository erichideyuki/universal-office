@test.0 "adaptador sheet-core → motor > compartilhadas, CSE, dinâmicas, nomes, externas, tabelas"
@test.1 "funções do ATP chamadas como suplemento (.xls) > resolve pelo nome no idioma; nome em inglês que difere fica #NAME? com @"
@test.2 "ordem de textos e números do Excel > ordem medida (97×97 pares em cmp.cases e o SORT de 172 textos do FN-TDL)"
@test.3 "ordem de textos e números do Excel > números a 15 algarismos"
@test.4 "contrato > levanta escalar sobre matriz e referência"
@test.5 "contrato > conversões"
@test.6 "contrato > datas 1900"
@test.7 "contrato > critérios"
@test.8 "cancelamento do Excel (medido) > expoente do acumulador, não do maior operando"
@test.9 "motor > argumento omitido ≠ célula vazia (isOmitted)"
@test.10 "motor > aritmética e precedência"
@test.11 "motor > cadeia longa sem estourar a pilha"
@test.12 "motor > derrama e bloqueia"
@test.13 "motor > legado: interseção implícita"
@test.14 "motor > IF, LET, LAMBDA, MAP"
@test.15 "motor > arquivo: _xlop. (opcional), _xleta. (função como valor), _TRO_ (corte)"
@test.16 "motor > INDEX, OFFSET, INDIRECT, ROW/COLUMN"
@test.17 "motor > edição incremental"
@test.18 "motor > referência circular: sem iterativo ficam os valores anteriores (0)"
@test.19 "motor > ciclo só estático (ramo de IF não escolhido) não é circular"
@test.20 "motor > cálculo iterativo"
@test.21 "motor > mudanças para a UI e texto de tela"
