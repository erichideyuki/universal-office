/// The Slides display list: the TS canvas call sequence of one slide at one (scale, origin), as the
/// producer (uo-pptx with uo-dml-render) emits it and the TS interpreter (`paint-slides.ts`, R-S3), the
/// recording context (R-S4) and uo-pdf (R-S5) read. Design: record `core/docs/modules/uo-render.md`,
/// "Slides extensions (plan §4.2) — design" (S1-S10) and "Slides extensions - R-S1/R-S2 implementation".
/// A separate schema from `render.uos` (W0): Write's bytes and hash do not change.
///
/// Rules of this schema (the P-DL1 canvas IR rule):
/// - every value the TS computed from MODEL data is precomputed by the producer with the TS arithmetic
///   (f64 bits); every value it computed from CANVAS state (current transform, device measureText, pixels,
///   canvas size, capability tests) is a symbolic operand the painter resolves (`CaptureCtm`,
///   `TransformByInverseOf`, `CtmOperand`, `Layer*`, `fit`); only pixel-reading or device-measuring code is an
///   `Effect` the shell executes with the TS code;
/// - colours are the CSS strings the TS built (`sym`, assigned to the canvas unparsed);
/// - the arenas (`paths`, `stops`, `dashes`, `texts`, `gradients`, `patterns`, `runs`, `effects`, `slots`)
///   are lists of the message; items hold indices or `Span`s into them. Spans count elements (`texts`: UTF-16
///   code units, as the TS strings). The decoder never validates them: `uo_render::slides::validate` does
///   (the Rust side) and the TS interpreter bounds-checks;
/// - persistent resources (faces, media, derived images, generated bitmaps) are tables sent as per-generation
///   deltas; everything that depends on the scale lives in the list, never in a table;
/// - the per-frame animation values are another message (core/schema/slots.uos), positional over `slots`.
schema slides magic "UORS";

/// A font as `(family, bold, italic)`; the painter builds the CSS font string with the shell's font stack (T2).
table faces: FaceKey;
/// A media part of the package (picture, video poster...) by its natural size; the shell holds the decoded
/// image, the list refers to it by position.
table media: Media;
/// An image with colour effects applied (the TS `fxImage` result), cached by the shell by this entry.
table derived: Derived;
/// A bitmap generated by the producer (pattern tiles, path-gradient rasters, TIFF, metafile rasters): the bytes
/// are pulled by handle (`bytes_ref`), RGBA 8-bit, `w * h * 4` bytes.
table bitmaps: Bitmap;

struct FaceKey {
  family: sym,
  bold: bool,
  italic: bool,
}

struct Media {
  /// the package part name (the key the shell loads the image by)
  part: sym,
  ext: sym,
  byte_len: u32,
  has_svg: bool,
  natural: PxSize?,
}

struct PxSize {
  w: u32,
  h: u32,
}

struct Derived {
  image: ref<media>,
  fx: ImageFx,
}

/// The colour effects of an `<a:blip>`; `alpha` is not here (it becomes `GlobalAlpha`).
struct ImageFx {
  duotone: Duotone?,
  gray: bool,
  bi_level: f64?,
  bright: f64?,
  contrast: f64?,
  clr_change: ClrChange?,
}

struct Duotone {
  first: sym,
  second: sym,
}

struct ClrChange {
  from: sym,
  to: sym,
  to_alpha: f64,
}

struct Bitmap {
  w: u32,
  h: u32,
  data: bytes_ref,
}

struct Pair {
  x: f64,
  y: f64,
}

/// `a b c d e f` of a canvas matrix (the TS `DOMMatrix` fields).
struct Mat6 {
  a: f64,
  b: f64,
  c: f64,
  d: f64,
  e: f64,
  f: f64,
}

/// `x y w h`.
struct Rect4 {
  x: f64,
  y: f64,
  w: f64,
  h: f64,
}

/// A range of an arena: `len` elements from `start`.
struct Span {
  start: u32,
  len: u32,
}

/// The TS `SlidePx` plus the scale: origin, scale and slide size in px. The producer built the list for these
/// values; slot math and the shell's checks read them.
struct ViewBox {
  ox: f64,
  oy: f64,
  scale: f64,
  sw: f64,
  sh: f64,
}

message SlidesList {
  view: ViewBox,
  /// paint order
  items: list<SItem>,
  /// path arena (`AppendPath`, `Bevel` silhouettes)
  paths: list<PathOp>,
  /// gradient stop arena
  stops: list<Stop>,
  /// `setLineDash` segment arena
  dashes: list<f64>,
  /// run texts, UTF-16 code units
  texts: utf16,
  gradients: list<Gradient>,
  patterns: list<PatternRes>,
  /// `Text(i)` items point here (keeps the item small)
  runs: list<TextRun>,
  /// `Effect(i)` items point here
  effects: list<Effect>,
  /// the animation slots the items open with `SlotBegin(i)`: the template of the per-frame values
  slots: list<SlotDef>,
}

enum PathOp tag "op" {
  MoveTo = "moveTo" (Pair),
  LineTo = "lineTo" (Pair),
  BezierTo = "bezierTo" (Cubic),
  QuadTo = "quadTo" (Quad),
  Arc = "arc" (ArcOp),
  ArcTo = "arcTo" (ArcToOp),
  Ellipse = "ellipse" (EllipseOp),
  Rect = "rect" (Rect4),
  Close = "close",
  /// `ctx.roundRect(x, y, w, h, r)` with one radius (the chart engine's rounded frame and its legend swatches)
  RoundRect = "roundRect" (RoundRectOp),
}

struct Cubic {
  x1: f64,
  y1: f64,
  x2: f64,
  y2: f64,
  x: f64,
  y: f64,
}

struct Quad {
  x1: f64,
  y1: f64,
  x: f64,
  y: f64,
}

/// `ctx.arc(cx, cy, r, a0, a1, ccw)`
struct ArcOp {
  cx: f64,
  cy: f64,
  r: f64,
  a0: f64,
  a1: f64,
  ccw: bool,
}

/// `ctx.arcTo(x1, y1, x2, y2, r)`
struct ArcToOp {
  x1: f64,
  y1: f64,
  x2: f64,
  y2: f64,
  r: f64,
}

/// `ctx.roundRect(x, y, w, h, r)`: the producer never emits a negative radius (the canvas throws)
struct RoundRectOp {
  x: f64,
  y: f64,
  w: f64,
  h: f64,
  r: f64,
}

/// `ctx.ellipse(x, y, rx, ry, rot, a0, a1, ccw)`
struct EllipseOp {
  x: f64,
  y: f64,
  rx: f64,
  ry: f64,
  rot: f64,
  a0: f64,
  a1: f64,
  ccw: bool,
}

struct Stop {
  offset: f64,
  /// the CSS colour string as the TS built it
  color: sym,
}

/// The arguments of createLinearGradient (x0 y0 x1 y1), createRadialGradient (x0 y0 r0 x1 y1 r1) or
/// createConicGradient (angle x y), in `g0..`; the unused ones are 0. The kind is the `Paint` variant.
struct Gradient {
  g0: f64,
  g1: f64,
  g2: f64,
  g3: f64,
  g4: f64,
  g5: f64,
  stops: Span,
}

enum Repeat {
  Repeat = "repeat",
  RepeatX = "repeat-x",
  RepeatY = "repeat-y",
  NoRepeat = "no-repeat",
}

enum PatternSrc tag "kind" {
  Bitmap = "bitmap" (ref<bitmaps>),
  Image = "image" (ImageSrc),
}

/// `ctx.createPattern`: `transform` is applied with `pat.setTransform` when the canvas supports it, else ignored
/// (the TS test). With `tile` the pattern is the TS `tilePattern` (`@universal-office/charts`, `image.ts`): the
/// painter reads the live transform (`hypot(a, b)`, `hypot(c, d)`) and the decoded image size, so the list
/// carries only the parameters; `repeat` is `repeat` and `transform` is ignored.
struct PatternRes {
  src: PatternSrc,
  repeat: Repeat,
  transform: Mat6?,
  tile: TileDef?,
}

/// The model-side parameters of an `<a:tile>` use (`imageTile`, render.ts:522-530): the natural size of the tile
/// is `image px x unit x scale` (`unit` = 914400 / dpi, or 9525 without a resolution), `tx`/`ty` are EMU (the
/// painter multiplies them by `scale`).
struct TileParams {
  unit_x: f64,
  unit_y: f64,
  sx: f64,
  sy: f64,
  tx: f64,
  ty: f64,
  /// `a:tile algn`
  algn: sym?,
  /// `x`, `y` or `xy`
  flip: sym?,
}

/// `tilePattern(ctx, img, iw, ih, natW, natH, spec, box)` of one pattern: `scale` is px per EMU, `bx` the box.
///
/// `nat` (the chart engine, CT-1): the natural tile size in px the producer computed with the TS arithmetic
/// (`(wPt ?? w * 0.75) * S`, render.ts:261); when present `scale` is 1, `unit_x`/`unit_y` are not read and `tx`/`ty`
/// are already px, so the painter passes the numbers to `tilePattern` as they are.
struct TileDef {
  params: TileParams,
  scale: f64,
  bx: Rect4,
  nat: Pair?,
}

/// The four fractions of a `fillToRect` / `fillRect`.
struct Edges {
  l: f64,
  t: f64,
  r: f64,
  b: f64,
}

enum ImageSrc tag "kind" {
  Media = "media" (ref<media>),
  Derived = "derived" (ref<derived>),
  Bitmap = "bitmap" (ref<bitmaps>),
}

enum Paint tag "kind" {
  Css = "css" (sym),
  Linear = "linear" (u32),
  Radial = "radial" (u32),
  Conic = "conic" (u32),
  Pattern = "pattern" (u32),
}

enum CompositeOp {
  SourceOver = "source-over",
  DestinationIn = "destination-in",
  DestinationOut = "destination-out",
  SourceIn = "source-in",
  Multiply = "multiply",
  Screen = "screen",
  Darken = "darken",
  Lighten = "lighten",
}

enum Join {
  Round = "round",
  Bevel = "bevel",
  Miter = "miter",
}

enum Cap {
  Butt = "butt",
  Round = "round",
  Square = "square",
}

enum Align {
  Left = "left",
  Right = "right",
  Center = "center",
  Start = "start",
  End = "end",
}

enum Baseline {
  Alphabetic = "alphabetic",
  Top = "top",
  Hanging = "hanging",
  Middle = "middle",
  Ideographic = "ideographic",
  Bottom = "bottom",
}

enum FillRule {
  NonZero = "nonzero",
  EvenOdd = "evenodd",
}

enum CtmAxis {
  A = "a",
  B = "b",
}

/// `add + ctm.<axis> * k` evaluated on the painter's current transform (the off-screen shadow idiom:
/// `shadowOffsetX = sx + m.a * K`). `m.a * K - dx` is `add = -dx`: the sum is commutative.
struct CtmOperand {
  add: f64,
  k: f64,
  axis: CtmAxis,
}

struct ShadowOff {
  x: CtmOperand,
  y: CtmOperand,
}

struct FontRef {
  face: ref<faces>,
  size_px: f64,
}

struct FillTextItem {
  text: Span,
  x: f64,
  y: f64,
}

struct DrawImageItem {
  src: ImageSrc,
  /// source rectangle (the 9-argument drawImage)
  s: Rect4?,
  d: Rect4,
}

struct LayerBeginItem {
  layer: u32,
  /// no layer available (tests, old browsers): jump to this item index (the TS else-branch)
  fallback_end: u32,
}

/// What happens to a layer at its end: `Composite` draws it onto the previous target under the identity
/// transform after applying the soft reveals the enclosing shape slot's value produced (`applySoftReveal`,
/// `compositeLayer`); `Keep` leaves it for a later `DrawLayer` (soft-edge mask, reflection).
enum LayerThen {
  Composite = "composite",
  Keep = "keep",
}

struct LayerEndItem {
  layer: u32,
  then: LayerThen,
}

struct MediaFrameItem {
  shape: u32,
  d: Rect4,
  s: Rect4?,
}

/// One item is one canvas call or one state assignment (the TS sequence, so the recorder composes them in order).
enum SItem tag "op" {
  Save = "save",
  Restore = "restore",
  Translate = "translate" (Pair),
  Rotate = "rotate" (f64),
  Scale = "scale" (Pair),
  Transform = "transform" (Mat6),
  SetTransform = "setTransform" (Mat6),
  ResetTransform = "resetTransform",
  /// register := the current transform (`const baseM = ctx.getTransform()`); registers 0-3
  CaptureCtm = "captureCtm" (u32),
  /// `ctx.transform(inv.a, ...)` of the inverse of a captured register (the reflection)
  TransformByInverseOf = "transformByInverseOf" (u32),
  /// `ctx.getTransform().inverse().multiply(baseM)` applied with setTransform (`useBgFill`)
  TransformUnshape = "transformUnshape" (u32),
  /// `ctx.setTransform(baseM)` of a captured register (the 3D extrusion draws in the slide's frame)
  SetTransformReg = "setTransformReg" (u32),
  GlobalAlpha = "globalAlpha" (f64),
  /// `ctx.globalAlpha = ctx.globalAlpha * a` (the operand order is the TS one)
  GlobalAlphaMul = "globalAlphaMul" (f64),
  Composite = "composite" (CompositeOp),
  /// `blur(1.23px)` exactly as the TS string
  FilterSet = "filterSet" (sym),
  FilterNone = "filterNone",
  FillStyle = "fillStyle" (Paint),
  StrokeStyle = "strokeStyle" (Paint),
  LineWidth = "lineWidth" (f64),
  LineJoin = "lineJoin" (Join),
  LineCap = "lineCap" (Cap),
  MiterLimit = "miterLimit" (f64),
  /// span of `dashes`; empty = `setLineDash([])`
  LineDash = "lineDash" (Span),
  ShadowColor = "shadowColor" (sym),
  ShadowBlur = "shadowBlur" (f64),
  ShadowOffset = "shadowOffset" (ShadowOff),
  Font = "font" (FontRef),
  /// the chart engine's `ctx.font = [italic ][bold ]<size.toFixed(2)>px <stack>` (render.ts:177-180): not `Font`'s string
  /// (`700 <JS number>px`), so the recorder's `font=` and the `toFixed(2)` rounding are the chart's own
  ChartFont = "chartFont" (FontRef),
  /// a plain `ctx.fillText(text, x, y)` under the current state (no fit, no kerning change): the chart's labels
  FillText = "fillText" (FillTextItem),
  TextAlign = "textAlign" (Align),
  TextBaseline = "textBaseline" (Baseline),
  ImageSmoothing = "imageSmoothing" (bool),
  BeginPath = "beginPath",
  /// the path ops of a span of `paths`, in order
  AppendPath = "appendPath" (Span),
  Fill = "fill" (FillRule),
  Stroke = "stroke",
  Clip = "clip" (FillRule),
  FillRect = "fillRect" (Rect4),
  StrokeRect = "strokeRect" (Rect4),
  ClearRect = "clearRect" (Rect4),
  DrawImage = "drawImage" (DrawImageItem),
  /// the TS computes `fxImage(raw, fx)` at this point (the derived image is built, and cached, here): the painter
  /// realizes the source now, so the order of its scratch canvases is the TS's
  Prepare = "prepare" (ImageSrc),
  /// one `drawText` call: an index of `runs`
  Text = "text" (u32),
  LayerBegin = "layerBegin" (LayerBeginItem),
  LayerEnd = "layerEnd" (LayerEndItem),
  DrawLayer = "drawLayer" (u32),
  ReleaseLayer = "releaseLayer" (u32),
  /// shell-executed code: an index of `effects`
  Effect = "effect" (u32),
  /// opens the animation slot `slots[i]`; the items up to the matching `SlotEnd` are the part it governs
  SlotBegin = "slotBegin" (u32),
  SlotEnd = "slotEnd",
  MediaFrame = "mediaFrame" (MediaFrameItem),
}

struct TextShadow {
  color: sym,
  blur: f64,
  dx: f64,
  dy: f64,
}

struct TextOutline {
  color: sym,
  width: f64,
}

struct Decoration {
  color: sym,
  width: f64,
  y: f64,
}

/// One `drawText` call (render.ts:1636-1707) with every model-derived value precomputed (decision T1); the
/// painter replays it in the TS order, including the fit.
struct TextRun {
  text: Span,
  font: FontRef,
  x: f64,
  /// the baseline, including `rise x scale`
  y: f64,
  /// `r.w x scale` when the text is the whole run text; absent for unit pieces
  laid_w: f64?,
  /// `!ls && text === r.text && !st` (the painter adds its own `prevLs !== undefined`)
  fit_allowed: bool,
  /// `r.spc x scale` (0 = none)
  letter_spacing_px: f64,
  /// `fontKerning = kern ? 'normal' : 'none'` when supported
  kern: bool,
  fill: Paint,
  /// a bullet or marker: the TS sets `ctx.font` and `fillStyle` and calls `fillText`, nothing else (no kerning
  /// state, spacing, fit, alpha, shadow or decoration); only `text`, `font`, `x`, `y` and `fill` are read
  bullet: bool,
  /// `fillA < 1`: `globalAlpha x fillA`
  alpha_mul: f64?,
  shadow: TextShadow?,
  /// false when fillA <= 0 (outline only)
  fill_text: bool,
  outline: TextOutline?,
  underline: Decoration?,
  strike: Decoration?,
}

enum Effect tag "kind" {
  Bevel = "bevel" (BevelEffect),
  Warp = "warp" (WarpEffect),
  MetafileRop = "metafileRop" (MetafileRopEffect),
}

/// `applyBevel`: the silhouette is the path span; the shell reads the device rect (`getImageData`), so it is code.
/// The light table is looked up by `rig`/`mat` in the shell (uo-drawingml `light3d`).
struct BevelEffect {
  path: Span,
  rule: FillRule,
  bx: Rect4,
  /// the bevel width and height in model units (`b.w`, `b.h`); the painter multiplies by `scale` and the device scale
  w: f64,
  h: f64,
  scale: f64,
  prst: sym?,
  rig: sym?,
  mat: sym?,
  /// the light direction of the rig (`Bevel.dir`: `t`, `tl`, ...; the TS `lightAt(tab, b.dir, ...)`)
  dir: sym?,
}

/// `paintWarp` from the laid-out lines on (render.ts:1868-1984 and text-warp.ts).
struct WarpEffect {
  prst: sym,
  adj: list<f64>?,
  from_word_art: bool,
  bx: Rect4,
  px_per_pt: f64,
  lines: list<WarpLine>,
  /// the canvas shadow parameters of the layer composite (already x scale and x the blur constant)
  shadow: TextShadow?,
  /// a tiled picture over the warped silhouette (`source-in`): the TS `imageTile(layer, ..., x, y, scale, w, h)`
  tile: WarpTile?,
}

struct WarpTile {
  image: ImageSrc,
  tile: TileDef,
}

struct WarpLine {
  runs: list<WarpRun>,
  baseline: f64,
  size_pt: f64,
  height: f64?,
  ln_pct: f64?,
  align: sym,
  trailing: f64?,
}

struct WarpFont {
  face: ref<faces>,
  size_pt: f64,
}

struct WarpPattern {
  prst: sym,
  fg: sym,
  bg: sym,
}

struct WarpStroke {
  color: sym,
  width: f64,
}

enum WarpPaintKind {
  Linear = "linear",
  Radial = "radial",
  Path = "path",
  Image = "image",
}

/// The letter fill built on the raster box at warp time (`letterFill`), so it travels as a spec. `stops` are the
/// final stops `makeLinearGradient` adds (the PowerPoint sub-stops already expanded); a path gradient (`kind` path:
/// `path` is `circle`, `rect` or `shape`) is rasterized by the painter from `raw` (the model stops: position,
/// `#RRGGBB`, alpha) and `fill_to`, and falls back to the circular radial gradient of `stops` when it cannot.
struct WarpPaint {
  kind: WarpPaintKind,
  angle: f64?,
  scaled: bool,
  stops: list<Stop>,
  path: sym?,
  fill_to: Edges?,
  raw: list<RawStop>,
  image: ImageSrc?,
  /// `fillTile`: the tile parameters (scale and box come from the warp raster)
  tile: TileParams?,
  /// `a:fillRect` of a stretched picture
  fill_rect: Edges?,
}

struct RawStop {
  pos: f64,
  color: sym,
  alpha: f64,
}

struct WarpRun {
  text: utf16,
  font: WarpFont,
  x: f64,
  color: sym,
  stroke: WarpStroke?,
  pattern: WarpPattern?,
  spc: f64?,
  paint: WarpPaint?,
  alpha: f64?,
}

/// The raster-op path of metafile.ts (312-330, `getImageData`).
struct MetafileRopEffect {
  rop: u32,
  rect: Rect4,
  operand: ref<bitmaps>,
}

enum SlotKind {
  /// one per animated or opacity-faded shape: `shapeOpacity`, `hooks.all`
  Shape = "shape",
  /// the shape body only (`hooks.bg`)
  Background = "background",
  /// paragraph `index` (`hooks.para`)
  Paragraph = "paragraph",
  /// text unit `index` (letter or word)
  Unit = "unit",
  /// chart part `index`
  ChartPart = "chartPart",
  /// the picture's video/GIF frame
  Media = "media",
}

/// The template of one slot: what `AnimBase` and `applyPart` need from the producer (px geometry, normalized by
/// the slide's px size). Per (scale, origin) list; a resize re-emits it.
struct SlotDef {
  kind: SlotKind,
  /// the shape's index in the slide (the key the playback state uses)
  shape: u32,
  /// paragraph / unit / chart part number; 0 otherwise
  index: u32,
  /// `boxBase(...)`: centre and size as a fraction of the slide
  base: Rect4,
  /// the part's box in px (`x, y, w, h` of `applyPart`)
  bx: Rect4,
  /// the shape's own rotation in radians (`baseRotRad`)
  base_rot_rad: f64,
  /// a unit slot also has a word effect (`words`)
  words: bool,
}
