// The session protocol of <universal-write> over wasm (milestone 2): the messages of
// `uo_session_exec`, `uo_session_complete`, `uo_session_query`, the hot paths and the font save
// (record core/docs/modules/uo-bindings.md, "Milestone 2: the session in wasm").
//
// The command and output types mirror uo-docx's session types one to one; schema/session.bind binds
// each to its Rust type (core/tools/uo-schema rust_bind), so a new variant or field there fails to
// compile until it is added here. The type part was drafted from the uo-docx sources by a throwaway
// extractor and finished by hand.
//
// Wire rules of the binding (declared in the record): i64/i8 travel as i32 (checked), usize as u32;
// `JsNumber` as f64 (the TS `null` goes out as NaN, never comes back as `null`); `Str`/`String`
// arguments are built from UTF-16 (a lone surrogate becomes U+FFFD); maps (`JsRecord`, `IndexMap`)
// as lists of pairs in their order; Rust tuples as `Tup*` structs; an `Option` where the IDL has no
// optional as an `Opt*` struct of one optional field.
schema write_session magic "UOWS";

// ───────────────────────────── messages ─────────────────────────────

/// `uo_session_exec`: one operation of the session
message Exec {
  op: ExecOp,
}

/// `uo_session_complete`: the answer to a job of a pending two-phase command
message Complete {
  job: u32,
  result: JobResult,
}

/// what `exec`, `complete` and every hot path answer
message ExecResult {
  outcome: ExecOutcome,
}

/// `uo_session_query`
message Query {
  q: QueryOp,
}

message QueryResult {
  r: QueryAnswer,
}

/// `uo_session_open` / `uo_session_new_blank`: how the session opens
message SessionOpen {
  /// Modo Protegido (the TS `loadDocx` default is `true`; hosts pass `false`)
  protected: bool,
  /// `author` (default "Author")
  author: utf16?,
  tracking: bool?,
  markup: MarkupMode?,
  /// the language of a new document (`newDocument`, `spellcheck-default-lang`)
  lang: utf16?,
  /// the clock of the session (dates of revisions, comments, DATE fields); default 2026-01-02 03:04
  clock: LocalNow?,
  /// the seed of the TS `Math.random` sites (xorshift32; 0 = the fixed default)
  seed: u32,
  /// the undo history cap in steps (default: uo-docx `HistoryLimits`)
  max_history_steps: u32?,
  /// the clipboard identity (G7; default: a counter of the module)
  session_id: u32?,
}

/// `uo_session_font_requests`: the faces the save wants (phase 1 of the fonts on save)
message FontRequests {
  settings: EmbeddingSettings,
  requests: list<FaceRequest>,
}

/// `uo_session_save_with_fonts`: one answer per request, in order, and 16 random bytes per face (the GUIDs)
message FontFaces {
  faces: list<FaceAnswer>,
  guids: bytes,
}

/// what `uo_session_save_with_fonts` answers
message SaveResult {
  bytes: bytes,
  events: list<Event>,
}

/// `uo_session_caret_rect`: page twips (in the text frame when `xf`)
message Caret {
  page: u32,
  x: f64,
  y: f64,
  h: f64,
  xf: list<f64>?,
}

/// `uo_session_hit_test`: a position in the edited paragraphs
message Hit {
  para: u32,
  offset: u32,
}

/// `uo_session_selection_rects`
message SelRects {
  rects: list<SelRect>,
}

// ───────────────────────────── binding-level types ─────────────────────────────

/// an operation of `uo_session_exec`
enum ExecOp {
  Command(Command),
  Undo,
  Redo,
  /// drops a pending two-phase command (no step, no change)
  CancelPending,
  /// `uw-dirty-change` from the host (after its own save)
  SetDirty(bool),
  /// `applyPainter()` with the painter the last `CopyFormat` query stored in the handle
  ApplyPainter,
  /// `fontEmbedding = { ...fontEmbedding, ...patch }` (no undo step)
  SetFontEmbedding(EmbeddingPatch),
  /// the clock of the session from now on
  SetClock(LocalNow),
  /// the interface language of the style names and the galleries (the element's `lang`)
  SetUiLang(UiLang),
}

enum ExecOutcome {
  Done(ChangeSet),
  Jobs(JobList),
  Error(CommandError),
}

struct JobList {
  jobs: list<Job>,
}

/// `FontEmbeddingSettings` (uo-fonts)
struct EmbeddingSettings {
  embed: bool,
  subset: bool,
  skip_common_fonts: bool,
}

struct EmbeddingPatch {
  embed: bool?,
  subset: bool?,
  skip_common_fonts: bool?,
}

enum FontVariant {
  Regular,
  Bold,
  Italic,
  BoldItalic,
}

struct FaceRequest {
  family: utf16,
  variant: FontVariant,
}

/// the bytes of a requested face (absent: the host has no file)
struct FaceAnswer {
  bytes: bytes?,
}

struct SelRect {
  x: f64,
  y: f64,
  w: f64,
  h: f64,
  xf: list<f64>?,
}

/// one item of the Office Clipboard of the instance (`ClipboardItems`)
struct ClipItem {
  id: u32,
  text: utf16,
  at: LocalNow,
}

/// the binding-level answers
struct ClipItems {
  version: u32,
  items: list<ClipItem>,
}

/// one face of `fontUsage()` (LQ15)
struct FontUse {
  family: utf16,
  variant: FontVariant,
  text: utf16,
}

// ───────────────────────────── queries ─────────────────────────────

/// a query of the session (one variant per public accessor of `uo_docx::session::Session` that answers model state, D2a-Q1)
enum QueryOp {
  Selection,
  TableSelection,
  RevisionAuthors,
  IsDirty,
  CanUndo,
  CanRedo,
  EditsSinceLoad,
  MarkStories,
  HasBookmark(QHasBookmark),
  Bookmarks(QBookmarks),
  CanInsertField,
  PasteOptions,
  PasteSpecialFormats,
  LastPasteRange,
  LinkSourceName,
  PasteDefaults,
  SelectedText,
  Comments,
  PaneKeys,
  FloatSelection,
  SelectedObjectCount,
  SelectionPaneItems,
  SelectedObjectState(QSelectedObjectState),
  FindQueryError(QFindQueryError),
  HighlightSpans,
  EvenOddHeaders,
  HeaderFooterOptions(QHeaderFooterOptions),
  PageNumberFormat(QPageNumberFormat),
  HfPartOfRef(QHfPartOfRef),
  HeaderFooterTemplates(QHeaderFooterTemplates),
  NavigationResult,
  SelectionRanges,
  Headings,
  CurrentHeading,
  SearchResults,
  EditingNote,
  LastConvertedNotes,
  CanInsertNote,
  NoteRefs(QNoteRefs),
  NoteCount(QNoteCount),
  NoteOptions(QNoteOptions),
  CoverPages(QCoverPages),
  HasCoverPage,
  CoverParaIndexes,
  Watermark(QWatermark),
  WatermarkTexts(QWatermarkTexts),
  WatermarkGalleryEntries(QWatermarkGalleryEntries),
  ParagraphBorderSides,
  ParagraphIndents,
  ParagraphTabStops,
  CompressResult,
  ReferencesResult,
  RefSeed,
  CaptionSettings,
  CaptionLabels,
  CaptionNumbering(QCaptionNumbering),
  AutoCaption,
  CaptionTarget,
  CrossReferenceKinds(QCrossReferenceKinds),
  CrossReferenceItems(QCrossReferenceItems),
  NextCaptionNumber(QNextCaptionNumber),
  DateTimeFormats(QDateTimeFormats),
  ManualHyphenationState,
  ManualHyphenationFrom,
  TableOfFiguresOptions,
  HasTableOfContents,
  InTableOfContents,
  TocTemplates,
  TableOfContentsOptions,
  TocLevel,
  RevisionEntries,
  RevisionCount,
  RevisionAuthorsNow,
  AuthorColorOf(QAuthorColorOf),
  MarkupOptions,
  SuggestFormula,
  PreviewFormula(QPreviewFormula),
  HasSelection,
  Range,
  CanonPos(QCanonPos),
  HyphenationSettings,
  Hyphenation,
  /// the Office Clipboard of the instance (G7)
  ClipboardItems,
  /// `copyFormat()`: stores the painter in the handle for `ExecOp::ApplyPainter`; answers whether there is one
  CopyFormat,
  /// `fontUsage()` (LQ15)
  FontUsage,
  /// the font embedding settings of the session
  FontEmbedding,
}

enum QueryAnswer {
  Selection(Selection),
  TableSelection(ATableSelection),
  RevisionAuthors(list<utf16>),
  IsDirty(bool),
  CanUndo(bool),
  CanRedo(bool),
  EditsSinceLoad(u32),
  MarkStories(list<MarkStory>),
  HasBookmark(bool),
  Bookmarks(list<BookmarkInfo>),
  CanInsertField(bool),
  PasteOptions(PasteOptions),
  PasteSpecialFormats(APasteSpecialFormats),
  LastPasteRange(ALastPasteRange),
  LinkSourceName(ALinkSourceName),
  PasteDefaults(PasteDefaults),
  SelectedText(utf16),
  Comments(list<DocumentComment>),
  PaneKeys(list<utf16>),
  FloatSelection(AFloatSelection),
  SelectedObjectCount(u32),
  SelectionPaneItems(list<PaneItem>),
  SelectedObjectState(ASelectedObjectState),
  FindQueryError(AFindQueryError),
  HighlightSpans(list<TupSearchLocU32U32>),
  EvenOddHeaders(bool),
  HeaderFooterOptions(HeaderFooterOptions),
  PageNumberFormat(PageNumberFormat),
  HfPartOfRef(AHfPartOfRef),
  HeaderFooterTemplates(list<TupUtf16Utf16>),
  NavigationResult(ANavigationResult),
  SelectionRanges(list<DocRange>),
  Headings(list<HeadingInfo>),
  CurrentHeading(i32),
  SearchResults(list<SearchResult>),
  EditingNote(AEditingNote),
  LastConvertedNotes(u32),
  CanInsertNote(bool),
  NoteRefs(list<NoteRefLoc>),
  NoteCount(u32),
  NoteOptions(NoteOptions),
  CoverPages(list<TupUtf16Utf16>),
  HasCoverPage(bool),
  CoverParaIndexes(list<u32>),
  Watermark(AWatermark),
  WatermarkTexts(list<utf16>),
  WatermarkGalleryEntries(list<WatermarkGalleryEntry>),
  ParagraphBorderSides(list<ParaBorderSide>),
  ParagraphIndents(IndentInfo),
  ParagraphTabStops(list<TabStopInfo>),
  CompressResult(u32),
  ReferencesResult(AReferencesResult),
  RefSeed(ARefSeed),
  CaptionSettings(CaptionSettings),
  CaptionLabels(list<CaptionLabelInfo>),
  CaptionNumbering(CaptionNumbering),
  AutoCaption(AAutoCaption),
  CaptionTarget(ACaptionTarget),
  CrossReferenceKinds(list<CrossRefKind>),
  CrossReferenceItems(list<CrossRefItem>),
  NextCaptionNumber(utf16),
  DateTimeFormats(list<TupUtf16Utf16>),
  ManualHyphenationState(AManualHyphenationState),
  ManualHyphenationFrom(AManualHyphenationFrom),
  TableOfFiguresOptions(ATableOfFiguresOptions),
  HasTableOfContents(bool),
  InTableOfContents(bool),
  TocTemplates(list<TupTocTemplateIdUtf16>),
  TableOfContentsOptions(ATableOfContentsOptions),
  TocLevel(f64),
  RevisionEntries(list<RevisionEntry>),
  RevisionCount(u32),
  RevisionAuthorsNow(list<utf16>),
  AuthorColorOf(utf16),
  MarkupOptions(MarkupOptions),
  SuggestFormula(utf16),
  PreviewFormula(APreviewFormula),
  HasSelection(bool),
  Range(DocRange),
  CanonPos(DocPosition),
  HyphenationSettings(HyphenationSettings),
  Hyphenation(HyphenationInfo),
  ClipboardItems(ClipItems),
  CopyFormat(bool),
  FontUsage(list<FontUse>),
  FontEmbedding(EmbeddingSettings),
}

