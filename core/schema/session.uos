/// `uo_docx::session::command::Command`
enum Command {
  Text(TextCmd),
  Context(ContextCmd),
  Settings(SettingsCmd),
  Format(FormatCmd),
  Paragraph(ParagraphCmd),
  List(ListCmd),
  Style(StyleCmd),
  Table(TableCmd),
  Section(SectionCmd),
  HeaderFooter(HeaderFooterCmd),
  Note(NoteCmd),
  Revision(RevisionCmd),
  Comment(CommentCmd),
  Bookmark(BookmarkCmd),
  Drawing(DrawingCmd),
  Picture(PictureCmd),
  Page(PageCmd),
  TextLayout(TextLayoutCmd),
  Clipboard(ClipboardCmd),
  Find(FindCmd),
  Navigation(NavigationCmd),
  Reference(ReferenceCmd),
}

