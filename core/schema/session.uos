/// `uo_docx::model::para::NumberingProps`
struct NumberingProps {
  kind: utf16,
  ilvl: f64,
  num_id: f64?,
}

/// `uo_docx::model::para::ParaTabStop`
struct ParaTabStop {
  pos_twips: f64,
  align: utf16,
  leader: utf16?,
}

/// `uo_docx::model::para::ParagraphBorders`
struct ParagraphBorders {
  top: BorderEdge?,
  left: BorderEdge?,
  bottom: BorderEdge?,
  right: BorderEdge?,
  between: BorderEdge?,
  bar: BorderEdge?,
}

/// `uo_docx::model::para::BlockSdt`
struct BlockSdt {
  key: SdtKey,
  gallery: utf16?,
  pr: utf16?,
}

/// `uo_docx::model::para::SectionBreak`
struct SectionBreak {
  sect_pr: SectPr,
  header_refs: list<HfRefEdit>,
  footer_refs: list<HfRefEdit>,
  raw: utf16?,
  id: f64?,
}

/// `uo_docx::model::para::BorderEdge`
struct BorderEdge {
  style: utf16,
  size_eighth_pt: f64,
  color: utf16?,
  space_pt: f64,
}

/// `uo_docx::model::para::SdtKey` (a newtype)
struct SdtKey { value: utf16 }

/// `Nullable<Box<PageBorders>>` (the TS `null` or a value)
enum NullableBoxPageBorders { Null, Val(PageBorders) }

/// `uo_docx::model::section::SectPr`
struct SectPr {
  page_width_twips: f64,
  page_height_twips: f64,
  margin_left_twips: f64,
  margin_right_twips: f64,
  margin_top_twips: f64,
  margin_bottom_twips: f64,
  type: utf16?,
  cols: Cols?,
  title_pg: bool?,
  header_distance_twips: f64?,
  footer_distance_twips: f64?,
  pg_num_start: f64?,
  pg_num_fmt: utf16?,
  pg_num_chap_style: f64?,
  pg_num_chap_sep: utf16?,
  pg_borders: NullableBoxPageBorders?,
  footnote_pr: NoteProps?,
  endnote_pr: NoteProps?,
  footnote_columns: f64?,
  ln_num_type: LineNumbering?,
  v_align: utf16?,
}

/// `uo_docx::model::para::HfRefEdit`
struct HfRefEdit {
  kind: utf16,
  type: utf16,
  rid: utf16,
}

/// `uo_docx::model::section::Cols`
struct Cols {
  count: f64,
  space_twips: f64,
  sep: bool,
  widths: list<ColWidth>?,
}

/// `uo_docx::model::formatting::NoteProps`
struct NoteProps {
  pos: utf16?,
  num_fmt: utf16?,
  num_start: f64?,
  num_restart: utf16?,
}

/// `uo_docx::model::section::LineNumbering`
struct LineNumbering {
  count_by: f64?,
  start: f64?,
  distance: f64?,
  restart: utf16?,
}

/// `uo_docx::model::section::ColWidth`
struct ColWidth {
  width_twips: f64,
  space_twips: f64,
}

/// `uo_docx::session::ops::revision_cmds::MarkupOptions`
struct MarkupOptions {
  ins_del: bool,
  formatting: bool,
  comments: bool,
  balloons: Balloons,
  authors: list<utf16>?,
}

/// `uo_docx::write::emit::settings::HyphenationSettings`
struct HyphenationSettings {
  auto: bool,
  caps: bool,
  zone: f64?,
  limit: f64,
}

/// `uo_docx::session::ops::text_layout::HyphenationInfo`
struct HyphenationInfo {
  auto: bool,
  caps: bool,
  zone_twips: f64,
  limit: f64,
}
