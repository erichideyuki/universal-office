<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the .NET facade (uo-bindings.md): the PDF of the fixture documents equal byte for byte
       to the frozen TS renderPdf and to the Rust native output, the memory gate M4 (Dispose() and the
       finalizer), a thread soak, errors and cancellation. Builds uo-ffi (release, feature count) into
       CARGO_TARGET_DIR (or core/target) and copies the library next to the tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CoreDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</CoreDir>
    <CargoTarget Condition="'$(CARGO_TARGET_DIR)' != ''">$(CARGO_TARGET_DIR)</CargoTarget>
    <CargoTarget Condition="'$(CARGO_TARGET_DIR)' == ''">$(CoreDir)/target</CargoTarget>
    <CargoJobs Condition="'$(CargoJobs)' == ''">4</CargoJobs>
    <NativeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">uo_ffi.dll</NativeName>
    <NativeName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libuo_ffi.so</NativeName>
    <NativeName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libuo_ffi.dylib</NativeName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- the tests read the fixtures of core/ wherever the build output goes (the artifacts path) -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CoreDir</_Parameter1>
      <_Parameter2>$(CoreDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniversalOffice.Docx\UniversalOffice.Docx.csproj" />
  </ItemGroup>
  <Target Name="BuildRustCore" BeforeTargets="Build">
    <Exec Command="cargo build -p uo-ffi --release --features count -j $(CargoJobs)" WorkingDirectory="$(CoreDir)" />
    <Copy SourceFiles="$(CargoTarget)/release/$(NativeName)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
