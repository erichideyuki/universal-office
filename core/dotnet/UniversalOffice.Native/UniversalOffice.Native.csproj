<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET facade over the Rust core (uo-ffi). Foundation skeleton: SafeHandle-owned native
       resources and the P/Invoke layer; the real API arrives with the modules. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>UniversalOffice.Native</RootNamespace>
  </PropertyGroup>
</Project>
