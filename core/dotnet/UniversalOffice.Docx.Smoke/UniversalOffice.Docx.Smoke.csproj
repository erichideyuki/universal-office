<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console smoke of the .NET facade (uo-bindings.md): docx/.doc -> PDF with the machine's fonts,
       as clickCompliance calls it, and `edit` (the Editing API flow of clickCompliance). Run with
       <in.docx> <out.pdf> or edit <in.docx> <template.docx> <out.docx>; builds uo-ffi (release, UoNative.targets). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniversalOffice.Docx\UniversalOffice.Docx.csproj" />
  </ItemGroup>
  <Import Project="..\UoNative.targets" />
</Project>
